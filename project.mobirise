          "_name": "features7",
          "_sourceTheme": "studiom4",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"features7 studiom4_features7 vertical-line\" group=\"Features\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\">\n\n\t<mbr-parameters>\n\t\t\n\t\t<header>Size</header>\n\t\t<input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"15\" step=\"1\" value=\"0\">\n\t\t<input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"15\" step=\"1\" value=\"0\">\n\t\t<header>Show/Hide</header>\n\t\t<input type=\"checkbox\" title=\"Show Title\" name=\"showTitle\">\n\t\t<input type=\"checkbox\" title=\"Show Subtitle\" name=\"showSubtitle\">\n\t\t<input type=\"checkbox\" title=\"Show Card Title\" name=\"showCardTitle\" checked>\n\t\t<input type=\"checkbox\" title=\"Author Name\" name=\"showName\" checked>\n\t\t<input type=\"checkbox\" title=\"Author Title\" name=\"showDesk\">\n\t\t<input type=\"checkbox\" title=\"Show Text\" name=\"showText\" checked>\n\t\t<header>Color</header>\n\t\t<input type=\"color\" title=\"Icons Color 1\" name=\"IconsColor\" value=\"#ffffff\">\n\t\t<input type=\"color\" title=\"Icons Color 2\" name=\"IconsColor2\" value=\"#ffffff\">\n\t\t<header>Additional</header>\n\t\t<select title=\"Cards\" name=\"cardsAmount\">\n\t\t\t<option value=\"1\">1</option>\n\t\t\t<option value=\"2\">2</option>\n\t\t\t<option value=\"3\" selected>3</option>\n\t\t\t<option value=\"4\">4</option>\n\t\t</select>\n\t\t<header>Additional</header>\n\t\t<input type=\"color\" title=\"Card Background\" value=\"#2125f1\" name=\"cardBg\">\n\t\t<header>Background</header>\n\t\t<fieldset type=\"background\" name=\"bg\" parallax>\n\t\t\t<input type=\"image\" title=\"Background Image\" value=\"@ADDONS_PATH@/studiom4/components/_images/man-3.jpg\" parallax>\n\t\t\t<input type=\"color\" title=\"Background Color\" value=\"#000000\" selected>\n\t\t\t<input type=\"video\" title=\"Background Video\" value=\"https://www.youtube.com/watch?v=36YgDDJ7XSc\">\n\t\t</fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@ADDONS_PATH@/studiom4/components/_images/women-1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n\n\t\t<input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" checked condition=\"bg.type !== 'color'\">\n\t\t<input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#000000\" condition=\"overlay && bg.type !== 'color'\">\n\t\t<input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.4\" condition=\"overlay && bg.type !== 'color'\">\n\t\t\n\t</mbr-parameters>\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n\n\n\t<div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n\t</div>\n\n\t<div class=\"container-fluid\">\n\t\t<div class=\"row\">\n\t\t\t<div class=\"title col-12 align-center\">\n\t\t\t\t<h2 class=\"mbr-bold mbr-fonts-style mbr-section-title mbr-white\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\">\n\t\t\t\t\tDesign the Web in Your Image</h2>\n\t\t\t\t<h3 class=\"mbr-section-subtitle mbr-bold mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showSubtitle\" data-app-selector=\".mbr-section-subtitle\">WE ARE DEGITAL &amp; CREATIVE AGENCY\n\t\t\t\t</h3>\n\t\t\t</div>\n\n\t\t\t<div class=\"card col-12 col-md-6\" mbr-class=\"{'col-lg-3': cardsAmount == '4',\n                            'col-lg-4': cardsAmount == '3'}\">\n\t\t\t\t<div class=\"img-block\">\n\t\t\t\t\t<div class=\"wrapper-img\">\n\t\t\t\t\t\t<img src=\"@PROJECT_PATH@/assets/images/raga-teatro-del-pueblo-150723-7078-2217x1473.jpeg\" alt>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class=\"title-block\">\n\t\t\t\t\t\t<h4 class=\"mbr-fonts-style signature mbr-bold mbr-white align-center\" mbr-theme-style=\"display-5\" mbr-if=\"showName\" data-app-selector=\".title-block, .signature\"><a href=\"Educacion_E.html\" class=\"text-white text-primary\">Educación</a></h4>\n\t\t\t\t\t\t<h5 class=\"desk mbr-fonts-style mbr-white align-center\" mbr-theme-style=\"display-4\" mbr-if=\"showDesk\" data-app-selector=\".desk\">Design</h5>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\n\t\t\t<div class=\"card col-12 col-md-6\" mbr-if=\"cardsAmount > 1\" mbr-class=\"{'col-lg-3': cardsAmount == '4',\n                            'col-lg-4': cardsAmount == '3'}\">\n\t\t\t\t<div class=\"img-block\">\n\t\t\t\t\t<div class=\"wrapper-img\">\n\t\t\t\t\t\t<img src=\"@PROJECT_PATH@/assets/images/17-musica-teatral-680x441.jpeg\" alt>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class=\"title-block\">\n\t\t\t\t\t\t<h4 class=\"mbr-fonts-style signature mbr-bold mbr-white align-center\" mbr-theme-style=\"display-5\" mbr-if=\"showName\" data-app-selector=\".title-block, .signature\"><a href=\"Espectaculos_E.html\" class=\"text-white text-primary\">Espectáculos</a></h4>\n\t\t\t\t\t\t<h5 class=\"desk mbr-fonts-style mbr-white align-center\" mbr-theme-style=\"display-4\" mbr-if=\"showDesk\" data-app-selector=\".desk\">Design</h5>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\n\t\t\t<div class=\"card col-12 col-md-6\" mbr-if=\"cardsAmount > 2\" mbr-class=\"{'col-lg-3': cardsAmount == '4',\n                            'col-lg-4': cardsAmount == '3'}\">\n\t\t\t\t<div class=\"img-block\">\n\t\t\t\t\t<div class=\"wrapper-img\">\n\t\t\t\t\t\t<img src=\"@PROJECT_PATH@/assets/images/26-raga-final-1189x832.jpeg\" alt>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class=\"title-block\">\n\t\t\t\t\t\t<h4 class=\"mbr-fonts-style signature mbr-bold mbr-white align-center\" mbr-theme-style=\"display-5\" mbr-if=\"showName\" data-app-selector=\".title-block, .signature\"><a href=\"Espectaculos_E.html\" class=\"text-white text-primary\">Galería</a></h4>\n\t\t\t\t\t\t<h5 class=\"desk mbr-fonts-style mbr-white align-center\" mbr-theme-style=\"display-4\" mbr-if=\"showDesk\" data-app-selector=\".desk\">Design</h5>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\n\t\t\t<div class=\"card col-12 col-md-6\" mbr-if=\"cardsAmount > 3\" mbr-class=\"{'col-lg-3': cardsAmount == '4',\n                            'col-lg-4': cardsAmount == '3'}\">\n\t\t\t\t<div class=\"img-block\">\n\t\t\t\t\t<div class=\"wrapper-img\">\n\t\t\t\t\t\t<img src=\"@ADDONS_PATH@/studiom4/components/_images/design-little/bike.jpg\">\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class=\"title-block\">\n\t\t\t\t\t\t<h4 class=\"mbr-fonts-style signature mbr-bold mbr-white align-center\" mbr-theme-style=\"display-5\" mbr-if=\"showName\" data-app-selector=\".title-block, .signature\">\n\t\t\t\t\t\t\t<a href=\"#\" class=\"text-white mbr-bold\">Bike</a></h4>\n\t\t\t\t\t\t<h5 class=\"desk mbr-fonts-style mbr-white align-center\" mbr-theme-style=\"display-4\" mbr-if=\"showDesk\" data-app-selector=\".desk\">Design</h5>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n</section>",
          "_cid": "vaBrSnBTil",
