            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-section-title": {
              "text-align": "left",
              "width": "100%",
              "margin-bottom": "60px",
              "font-weight": "700",
              "padding": "0"
