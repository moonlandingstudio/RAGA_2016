          "_name": "menu1",
          "_sourceTheme": "yogam5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"menu1\" group=\"Menu\" plugins=\"DropDown, TouchSwipe\" always-top global once=\"menu\" not-draggable position-absolute>\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" name=\"fullWidth\" title=\"Full Width\" checked>\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Logo\" name=\"showLogo\" checked>\n        <input type=\"range\" title=\"Logo Size\" inline name=\"logoSize\" min=\"2\" max=\"6\" step=\"0.1\" value=\"3.3\" condition=\"showLogo\">\n        <input type=\"checkbox\" title=\"Brand Name\" name=\"showBrand\">\n        <input type=\"checkbox\" title=\"Menu Items\" name=\"showItems\" checked>\n        <input type=\"checkbox\" title=\"Button\" name=\"showButton\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\">\n        <header>Styles</header>\n        <input type=\"checkbox\" title=\"Sticky\" name=\"sticky\">\n        <input type=\"checkbox\" title=\"Collapsed\" name=\"collapsed\">\n        <input type=\"checkbox\" title=\"Transparent\" name=\"transparent\" checked>\n        <input type=\"range\" title=\"Opacity\" name=\"opacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0\" condition=\"transparent\">\n        <input type=\"color\" title=\"Color\" name=\"menuBgColor\" value=\"#0e0f2d\">\n        <input type=\"color\" title=\"Hamburger\" name=\"hamburgerColor\" value=\"#ffffff\">\n    </mbr-parameters>\n\n    <nav class=\"navbar navbar-dropdown\" mbr-class=\"{'navbar-fixed-top':sticky,\n                     'navbar-expand-lg':!collapsed,\n                     'collapsed':collapsed}\">\n        <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n            <div class=\"navbar-brand\">\n                <span mbr-if=\"showLogo\" class=\"navbar-logo\">\n                    <a href=\"index.html\">\n                        <img src=\"@PROJECT_PATH@/assets/images/rag-png-mesa-de-trabajo-1-105x105.png\" alt mbr-style=\"{'height': logoSize + 'rem'}\">\n                    </a>\n                </span>\n                <span mbr-if=\"showBrand\" mbr-buttons mbr-theme-style=\"display-4\" class=\"navbar-caption-wrap\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd,-mbrBtnRemove,-iconFont\"><a class=\"navbar-caption text-white\" data-app-selector=\".navbar-caption\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">YogaM5</a></span>\n            </div>\n            <button class=\"navbar-toggler\" type=\"button\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-target=\"#navbarSupportedContent\" data-bs-target=\"#navbarSupportedContent\" aria-controls=\"navbarNavAltMarkup\" aria-expanded=\"false\" aria-label=\"Toggle navigation\" mbr-if=\"showItems || showIcons || showButtons\">\n                <div class=\"hamburger\">\n                    <span></span>\n                    <span></span>\n                    <span></span>\n                    <span></span>\n                </div>\n            </button>\n            <div class=\"collapse navbar-collapse\" id=\"navbarSupportedContent\" mbr-if=\"showItems || showIcons || showButtons\">\n                <ul mbr-menu class=\"navbar-nav nav-dropdown\" mbr-theme-style=\"display-4\" mbr-if=\"showItems\" mbr-class=\"{'nav-right': !showButtons,'navbar-nav-top-padding': isPublish && !showBrand && !showLogo}\"><li class=\"nav-item\"><a class=\"nav-link link text-white text-primary\" href=\"Raga_E.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" aria-expanded=\"false\">Raga<div class=\"line-animation\"></div></a></li>\n                    <li class=\"nav-item\"><a class=\"nav-link link text-white text-primary\" href=\"Espectaculos_E.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" aria-expanded=\"false\">Espectáculos</a></li>\n                    <li class=\"nav-item\"><a class=\"nav-link link text-white text-primary\" href=\"Educacion_E.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" aria-expanded=\"false\">Educación</a></li>\n                    <li class=\"nav-item\"><a class=\"nav-link link text-white text-primary\" href=\"Galeria_E.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" aria-expanded=\"false\">Galería</a></li></ul>\n                <div class=\"icons-menu\">\n                    <p class=\"mbr-text mbr-fonts-style\" mbr-if=\"showText\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-text, .button-align\">Raga2</p>\n                    <div class=\"mbr-section-btn\" mbr-if=\"showButton\" data-toolbar=\"-mbrBtnAdd, -mbrBtnMove, -mbrBtnRemove\" mbr-buttons mbr-theme-style=\"display-4\"><a class=\"btn btn-secondary-outline\" href=\"index.html#bottom\" data-app-placeholder=\"Type Text\">Contacto</a></div>\n                </div>\n            </div>\n        </div>\n    </nav>\n</section>",
          "_cid": "vaHlUMDF6D",
          "_anchor": "menu1-55",
          "_protectedParams": [],
          "_global": true,
          "_once": "menu",
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            "@media (max-width: 1199px)": {
              ".col-lg-4, .col-lg-8": {
                "width": "100%"
              }
            },
            ".text-wrapper": {
              "@media (max-width: 1199px)": {
                "text-align": "center",
                "margin-top": "50px"
              }
            },
            ".mbr-section-title": {
              "margin-bottom": "2.3rem",
              "span": {
                "position": "relative",
                "svg": {
                  "position": "absolute",
                  "top": "-30px",
                  "left": "-33px",
                  "width": "63px",
                  "height": "60px",
                  "transform": "rotate(275deg)",
                  "path": {
                    "fill": "@titleDecColor"
                  },
                  "& when not (@showTitle)": {
                    "display": "none"
                  },
                  "& when not (@addTitleDec)": {
                    "display": "none"
                  }
                }
              },
              "color": "#ffffff"
            },
            ".mbr-section-btn": {
              "margin-top": "83.4px",
              "@media (max-width: 1199px)": {
                "justify-content": "center!important"
              },
              "& when (@showButtons)": {
                "display": "flex",
                "flex-wrap": "wrap"
              },
              "& when not (@addBtnDec)": {
                "margin-top": "40px"
              }
            },
            ".button-container": {
              "position": "relative",
              "svg": {
                "position": "absolute",
                "top": "-65px",
                "left": "-50px",
                "width": "70px",
                "height": "75px",
                "@media (max-width: 1199px)": {
                  "left": "300px"
                },
                "@media (max-width: 991px)": {
                  "left": "200px"
                },
                "@media (max-width: 767px)": {
                  "left": "100px"
                },
                "@media (max-width: 519px)": {
                  "left": "90px"
                },
                "@media (max-width: 460px)": {
                  "left": "60px"
                },
                "@media (max-width: 359px)": {
                  "left": "0"
                },
                "path": {
                  "fill": "@btnDecColor"
                },
                "& when not (@showButtons)": {
                  "display": "none"
                },
                "& when not (@addBtnDec)": {
                  "display": "none"
                }
              }
            },
            ".image-container": {
              "height": "570px",
              "display": "flex",
              "justify-content": "flex-end",
              "overflow": "hidden",
              "@media (max-width: 1199px)": {
                "margin-top": "50px",
                "justify-content": "center"
              },
              "@media (max-width: 359px)": {
                "height": "490px"
              }
            },
            ".image-inner-container": {
              "display": "grid",
              "grid-template-columns": "200px 300px 200px",
              "grid-column-gap": "32px",
              "margin-top": "-150px",
              "@media (max-width: 1399px)": {
                "grid-column-gap": "14px"
              },
              "@media (max-width: 1199px)": {
                "grid-template-columns": "180px 280px 180px",
                "grid-column-gap": "28px",
                "margin-top": "0"
              }
            },
            ".tile": {
              "width": "100%",
              "margin-bottom": "16px",
              "img": {
                "width": "100%",
                "height": "100%",
                "object-fit": "cover"
              }
            },
            ".image-wrap": {
              "border-radius": "15px",
              "overflow": "hidden"
            },
            ".image-col": {
              "display": "flex",
              "flex-direction": "column",
              "align-items": "center"
            },
            ".col-aside": {
              "& when not (@showDescription)": {
                "padding-top": "60px"
              },
              ".image-wrap": {
                "height": "230px"
              }
            },
            ".col-middle": {
              "padding-top": "100px",
              "@media (max-width: 1199px)": {
                "padding-top": "50px",
                ".tile:last-child": {
                  "display": "none"
                }
              },
              "@media (max-width: 356px)": {
                "padding-top": "0"
              },
              "& when not (@showDescription)": {
                "padding-top": "165px"
              },
              ".image-wrap": {
                "height": "170px"
              }
            },
            ".mbr-text": {
              "color": "#ffffff"
            }
          },
          "_name": "image2",
          "_sourceTheme": "snackm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"image2\" group=\"Image & Video\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"10\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"0\" condition=\"fullScreen == false\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\" checked>\n        <select title=\"Align\" name=\"alignButtons\" condition=\"showButtons\">\n            <option value=\"justify-content-start\" selected>Left</option>\n            <option value=\"justify-content-center\">Center</option>\n            <option value=\"justify-content-end\">Right</option>\n        </select>\n        <input type=\"checkbox\" title=\"Description\" name=\"showDescription\">\n        <header>Decoration</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"addTitleDec\" condition=\"showTitle\">\n        <input type=\"color\" title=\"Color\" name=\"titleDecColor\" value=\"#33d5ad\" condition=\"addTitleDec\">\n        <input type=\"checkbox\" title=\"Button\" name=\"addBtnDec\" condition=\"showButtons\">\n        <input type=\"color\" title=\"Color\" name=\"btnDecColor\" value=\"#33d5ad\" condition=\"addBtnDec\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\">\n            <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/27-raga-final-1447x806.jpg\" parallax selected>\n            <input type=\"color\" title=\"Color\" value=\"#000000\">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.7\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n\n    <div class=\"container\">\n        <div class=\"row align-items-center\">\n            <div class=\"col-12 col-lg-4\">\n                <div class=\"text-wrapper\">\n                    <h3 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\">\n                        <span>\n                            <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 126 121\" fill=\"none\">\n                                <path fill-rule=\"evenodd\" clip-rule=\"evenodd\" d=\"M2.58298 3.09025C2.08298 5.00692 1.66631 6.96525 1.49964 8.92358C0.957977 15.8403 0.332979 39.0486 0.541312 43.7153C0.541312 45.1319 0.791311 46.7153 1.37464 48.0069C2.41631 50.2986 5.08298 50.4653 6.54131 48.3403C7.08298 47.5903 7.41631 46.5903 7.58298 45.6319C8.04131 42.8403 8.41631 40.0486 8.62464 37.2569C9.20797 28.8403 9.74964 20.3819 10.1246 11.9653C10.2496 9.17359 9.95797 6.34026 9.62464 3.54859C9.37464 1.46526 7.66631 -0.11808 6.08298 0.0069201C4.20798 0.173587 3.04131 1.38192 2.58298 3.09025ZM59.583 58.5897C59.7428 57.9507 59.8812 57.35 60.0134 56.7767L60.0134 56.7767C60.2949 55.5556 60.5477 54.4588 60.9163 53.3814C66.333 37.3814 75.0414 23.1314 84.958 9.58971C86.1247 8.00638 87.583 6.50638 89.208 5.50638C90.083 4.96471 91.833 5.04805 92.833 5.58972C93.583 6.00638 94.1247 7.63138 93.958 8.54805C93.6664 10.298 93.0414 12.0897 92.1664 13.6731C86.4164 24.1314 80.6247 34.5481 74.7497 44.9231C73.0215 47.9555 71.2168 50.9624 69.4154 53.9637C68.9149 54.7977 68.4146 55.6312 67.9163 56.4647C67.1663 57.7564 66.333 59.0064 65.458 60.1731C64.4997 61.5064 63.0413 62.2981 61.583 61.4231C61.491 61.367 61.3982 61.3125 61.3056 61.2582L61.3055 61.2581C60.4341 60.7466 59.583 60.2469 59.583 58.5897ZM118.583 120.633C117.915 120.521 117.209 120.419 116.481 120.314C115.033 120.104 113.498 119.882 112 119.549C103.125 117.549 94.2497 115.549 85.4163 113.466C83.4997 113.008 81.6247 112.216 79.9163 111.299C77.6247 110.091 76.833 108.383 77.208 106.508C77.583 104.633 79.083 103.466 81.708 103.424C83.4997 103.383 85.4164 103.424 87.1247 103.841C98.333 106.674 109.541 109.591 120.708 112.549C121.958 112.883 123.25 113.466 124.208 114.299C126.625 116.341 125.875 119.549 122.791 120.341C122.028 120.525 121.197 120.543 120.279 120.563H120.279H120.279C119.745 120.575 119.181 120.587 118.583 120.633Z\">\n                                </path>\n                            </svg>\n                            <b>EDUCACIÓN</b></span></h3>\n                    <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text\">\n                        Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt.\n                    </p>\n                    <div class=\"button-container\">\n                        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 191 195\" fill=\"none\">\n                            <path d=\"M188.259 168.622C188.613 169.648 188.558 170.772 188.104 171.759C187.651 172.746 186.835 173.52 185.826 173.922C184.294 174.445 182.631 174.441 181.102 173.91C179.254 173.333 177.455 172.613 175.72 171.756C173.66 170.849 170.674 169.523 168.725 168.379C166.367 166.997 153.301 158.638 151.534 157.293C148.91 155.297 142.581 149.576 141.437 148.461C140.66 147.662 139.883 146.863 139.029 145.985C136.13 149.594 132.346 149.374 129.343 148.795C126.645 148.273 124.47 146.618 122.107 145.158C117.935 142.543 113.964 139.618 110.229 136.409C98.4914 126.617 88.6245 115.006 77.8563 104.212C75.5352 101.898 73.3717 99.4187 71.1778 96.9811C66.0329 91.2709 60.9162 85.5492 55.8274 79.8159C54.3514 78.1527 42.9076 63.9747 41.7366 62.286C40.302 60.2173 34.2569 51.6753 32.9065 49.5719C31.1402 46.8714 26.0535 38.5638 25.2723 37.1911C24.491 35.8184 23.7422 34.2609 22.95 32.8164C22.3037 31.6187 19.6343 26.4388 18.9427 25.0614C18.4956 24.1413 18.0063 23.2505 17.5592 22.3304C16.3392 19.8644 15.1677 17.3514 14.0079 14.8505C13.8743 14.5799 13.6443 13.9435 13.4256 13.3432C13.2396 12.8646 13.2125 12.3389 13.3485 11.8438C13.4845 11.3487 13.7763 10.9105 14.1807 10.5942C15.9614 9.25118 17.912 12.008 18.1698 12.37C18.8657 13.5637 19.4752 14.8058 19.9935 16.0867C20.3705 16.8983 20.5743 17.7015 20.964 18.4536C22.4414 21.3053 23.9789 24.1341 25.4857 27.0161C26.6082 29.188 36.9693 46.4808 38.1692 48.2476C39.369 50.0144 52.2883 67.6116 54.3999 70.3886C54.6236 70.6186 54.7991 70.8839 55.0168 71.1199C61.9163 78.7838 68.6283 86.6183 75.6851 94.141C86.4713 105.644 97.3883 117.047 108.436 128.351C119.591 138.379 127.732 143.116 130.484 144.116C131.747 144.761 135.599 144.384 134.757 142.646L133.244 141.09C127.75 135.441 122.05 129.968 116.84 124.054C114.047 120.879 112.023 116.956 112.704 112.289C113.159 109.195 115.277 107.23 117.654 105.967C120.362 104.511 123.297 105.191 125.643 107.422C132.328 113.799 134.1 117.33 135.147 119.387C136.368 121.626 137.402 123.962 138.239 126.371C139.089 129.119 139.738 131.924 140.183 134.766C140.458 136.43 140.231 138.183 140.344 139.887C140.434 140.424 140.698 140.917 141.095 141.289C143.157 143.337 145.207 145.396 147.372 147.344C148.977 148.788 150.678 150.125 152.374 151.469C153.709 152.527 155.931 154.23 157.297 155.247C158.662 156.263 160.027 157.304 161.382 158.236C163.524 159.688 165.666 161.139 167.858 162.472C170.328 163.958 172.816 165.426 175.409 166.663C177.7 167.679 180.042 168.575 182.426 169.347C182.586 169.403 182.757 169.425 182.926 169.413C183.636 169.399 184.312 169.106 184.807 168.597C185.103 168.202 185.507 167.902 185.971 167.733C186.435 167.564 186.938 167.535 187.419 167.648C187.628 167.73 187.813 167.861 187.96 168.031C188.106 168.2 188.209 168.403 188.259 168.622V168.622ZM135.163 135.831C135.135 135.074 135.066 134.319 134.955 133.57C134.446 131.132 131.56 122.616 130.55 120.948C129.176 118.628 127.578 116.45 125.778 114.442C124.903 113.391 123.949 112.409 122.922 111.506C122.183 110.921 121.243 110.65 120.306 110.75C119.368 110.851 118.508 111.316 117.909 112.045C117.21 112.937 117.252 113.792 117.671 115.434C118.296 117.595 119.381 119.594 120.851 121.296C125.069 125.936 134.578 135.339 135.193 135.801L135.163 135.831Z\">\n                            </path>\n                        </svg>\n                        <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn {{alignButtons}}\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd\"><a class=\"btn btn-size btn-secondary\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\"><strong>INFO</strong></a></div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"col-12 col-lg-8\">\n                <div class=\"image-container\">\n                    <div class=\"image-inner-container\">\n                        <div class=\"image-col col-aside\">\n                            <div class=\"tile\">\n                                <div class=\"image-wrap\">\n                                    <img src=\"@PROJECT_PATH@/assets/images/rt-400x500.jpg\" alt>\n                                </div>\n                                <div class=\"mbr-description\">\n                                    <p class=\"mbr-description mbr-fonts-style mt-2\" mbr-theme-style=\"display-4\" mbr-if=\"showDescription\" data-app-selector=\".mbr-description\">\n                                        Image Description\n                                    </p>\n                                </div>\n                            </div>\n                            <div class=\"tile\">\n                                <div class=\"image-wrap\">\n                                    <img src=\"@PROJECT_PATH@/assets/images/4-400x529.jpg\" alt=\"Mobirise\">\n                                </div>\n                                <div class=\"mbr-description\">\n                                    <p class=\"mbr-description mbr-fonts-style mt-2\" mbr-theme-style=\"display-4\" mbr-if=\"showDescription\" data-app-selector=\".mbr-description\">\n                                        Image Description\n                                    </p>\n                                </div>\n                            </div>\n                            <div class=\"tile\">\n                                <div class=\"image-wrap\">\n                                    <img src=\"@PROJECT_PATH@/assets/images/5-integantes-400x265.jpg\" alt=\"Mobirise\">\n                                </div>\n                                <div class=\"mbr-description\">\n                                    <p class=\"mbr-description mbr-fonts-style mt-2\" mbr-theme-style=\"display-4\" mbr-if=\"showDescription\" data-app-selector=\".mbr-description\">\n                                        Image Description\n                                    </p>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"image-col col-middle\">\n                            <div class=\"tile\">\n                                <div class=\"image-wrap\">\n                                    <img src=\"@PROJECT_PATH@/assets/images/raga-01-020225-53-600x394.jpg\" alt>\n                                </div>\n                                <div class=\"mbr-description\">\n                                    <p class=\"mbr-description mbr-fonts-style mt-2\" mbr-theme-style=\"display-4\" mbr-if=\"showDescription\" data-app-selector=\".mbr-description\">\n                                        Image Description\n                                    </p>\n                                </div>\n                            </div>\n                            <div class=\"tile\">\n                                <div class=\"image-wrap\">\n                                    <img src=\"@PROJECT_PATH@/assets/images/26-raga-final-600x420.jpg\" alt=\"Mobirise\">\n                                </div>\n                                <div class=\"mbr-description\">\n                                    <p class=\"mbr-description mbr-fonts-style mt-2\" mbr-theme-style=\"display-4\" mbr-if=\"showDescription\" data-app-selector=\".mbr-description\">\n                                        Image Description\n                                    </p>\n                                </div>\n                            </div>\n                            <div class=\"tile\">\n                                <div class=\"image-wrap\">\n                                    <img src=\"@PROJECT_PATH@/assets/images/imagen-de-whatsapp-2025-04-30-a-las-08.20.10-640d73ff-600x385.jpg\" alt=\"Mobirise\">\n                                </div>\n                                <div class=\"mbr-description\">\n                                    <p class=\"mbr-description mbr-fonts-style mt-2\" mbr-theme-style=\"display-4\" mbr-if=\"showDescription\" data-app-selector=\".mbr-description\">\n                                        Image Description\n                                    </p>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"image-col col-aside\">\n                            <div class=\"tile\">\n                                <div class=\"image-wrap\">\n                                    <img src=\"@PROJECT_PATH@/assets/images/6-integranetes-400x266.jpg\" alt=\"Mobirise\">\n                                </div>\n                                <div class=\"mbr-description\">\n                                    <p class=\"mbr-description mbr-fonts-style mt-2\" mbr-theme-style=\"display-4\" mbr-if=\"showDescription\" data-app-selector=\".mbr-description\">\n                                        Image Description\n                                    </p>\n                                </div>\n                            </div>\n                            <div class=\"tile\">\n                                <div class=\"image-wrap\">\n                                    <img src=\"@PROJECT_PATH@/assets/images/tttt-400x500.jpg\" alt=\"Mobirise\">\n                                </div>\n                                <div class=\"mbr-description\">\n                                    <p class=\"mbr-description mbr-fonts-style mt-2\" mbr-theme-style=\"display-4\" mbr-if=\"showDescription\" data-app-selector=\".mbr-description\">\n                                        Image Description\n                                    </p>\n                                </div>\n                            </div>\n                            <div class=\"tile\">\n                                <div class=\"image-wrap\">\n                                    <img src=\"@PROJECT_PATH@/assets/images/7-integrantes-400x265.jpg\" alt=\"Mobirise\">\n                                </div>\n                                <div class=\"mbr-description\">\n                                    <p class=\"mbr-description mbr-fonts-style mt-2\" mbr-theme-style=\"display-4\" mbr-if=\"showDescription\" data-app-selector=\".mbr-description\">\n                                        Image Description\n                                    </p>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
