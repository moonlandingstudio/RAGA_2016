              "text-align": "center"
            },
            ".nav-wrapper": {
              "@media (max-width: 992px)": {
                "margin-bottom": "30px"
              },
              ".list": {
                "display": "inline-flex",
                "flex-wrap": "wrap",
                "justify-content": "center",
                "margin": "0",
