        {
          "_name": "form01",
          "_sourceTheme": "rebootm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"form01 rebootm5\" group=\"Form\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"5\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"5\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Label\" name=\"showLabel\" checked>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\" checked>\n        <header>Form</header>\n        <input type=\"color\" title=\"Input Color\" value=\"#a48bb2\" name=\"inputColor\" selected>\n        <input type=\"color\" title=\"Input Border\" value=\"#2a2a2a\" name=\"inputBorder\" selected>\n        <input type=\"color\" title=\"Active Color\" value=\"#ffffff\" name=\"activeColor\" selected>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/background7-1900x1200.jpg\" selected>\n            <input type=\"color\" title=\"Color\" value=\"#121212\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@ADDONS_PATH@/rebootm5/components/_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#121212\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.4\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row justify-content-center\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n            <div class=\"col-12 col-lg-5 card\">\n                <div class=\"content-wrapper\">\n                    <p class=\"mbr-label mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-label\" mbr-if=\"showLabel\">\n                        Contacto</p>\n                    <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\">\n                        Raga</h2>\n                    <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .text-wrapper\"></p>\n                </div>\n            </div>\n            <div class=\"col-12 col-lg-5 card\">\n                <h3 class=\"mbr-section-subtitle mbr-fonts-style\" data-app-selector=\".mbr-section-subtitle\" mbr-theme-style=\"display-5\" mbr-if=\"showSubtitle\"></h3>\n                <div mbr-form class=\"mbr-form form-wrap card-wrap\">\n                    <!--Formbuilder Form-->\n                    <form action=\"rogeliomelladofdez@gmail.com\" name=\"Form Name\" method=\"POST\" class=\"mbr-form form-with-styler\" data-verified=\"rogeliomelladofdez@gmail.com\">\n                        <div class=\"row\">\n                            <div hidden=\"hidden\" data-form-alert class=\"alert alert-success col-12\">Gracias por contactarnos. En breve te responderemos.</div>\n                            <div hidden=\"hidden\" data-form-alert-danger class=\"alert alert-danger col-12\"> Oops...! some\n                                problem!\n                            </div>\n                        </div>\n                        <div class=\"dragArea row\">\n                            <div class=\"col-lg-12 col-md-12 col-sm-12 form-group mb-3\" data-for=\"name\">\n                                <label mbr-text mbr-theme-style=\"display-7\" for=\"name\" class=\"form-control-label mbr-fonts-style\">Nombre</label>\n                                <input type=\"text\" name=\"name\" placeholder=\"Nombre Completo\" data-form-field=\"name\" mbr-theme-style=\"display-7\" class=\"form-control\" value>\n                            </div>\n                            <div class=\"col-lg-12 col-md-12 col-sm-12 form-group mb-3\" data-for=\"email1\">\n                                <label mbr-text mbr-theme-style=\"display-7\" for=\"email1\" class=\"form-control-label mbr-fonts-style\">Email</label>\n                                <input type=\"email\" name=\"email1\" placeholder=\"tucorreo@email.com\" data-form-field=\"email1\" mbr-theme-style=\"display-7\" class=\"form-control\" value>\n                            </div>\n                            <div data-for=\"textarea\" class=\"col-lg-12 col-md-12 col-sm-12 form-group mb-3\">\n                                <label mbr-text mbr-theme-style=\"display-7\" for=\"textarea\" class=\"form-control-label mbr-fonts-style\">Mensaje</label>\n                                <textarea name=\"textarea\" placeholder=\"Tu mensaje\" data-form-field=\"textarea\" mbr-theme-style=\"display-7\" class=\"form-control\"></textarea>\n                            </div>\n                            <div class=\"col-md-auto col mbr-section-btn\" mbr-buttons=\"true\" mbr-theme-style=\"display-7\" data-toolbar=\"-mbrBtnMove,-mbrLink,-mbrBtnRemove,-mbrBtnAdd\"><a type=\"submit\" class=\"btn btn-secondary-outline\" data-app-placeholder=\"Type Text\"><span class=\"mobi-mbri mobi-mbri-right mbr-iconfont mbr-iconfont-btn\"></span>Enviar</a></div>\n                        </div>\n                    </form><!--Formbuilder Form-->\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".row": {
              "margin": "0 -20px",
              ".card": {
                "padding": "0 20px"
              }
            },
            ".content-wrapper": {
              "@media (max-width: 992px)": {
                "margin-bottom": "40px"
              },
              ".mbr-label": {
                "margin-bottom": "12px"
              },
              ".mbr-section-title": {
                "margin-bottom": "12px"
              },
              ".mbr-text": {
                "margin-bottom": "0"
              }
            },
            ".mbr-section-subtitle": {
              "margin-bottom": "16px",
              "color": "#ffffff"
            },
            ".form-wrap": {
              ".dragArea.row": {
                "position": "relative",
                "z-index": "1",
                "margin": "0 -9.6px",
                ".form-group": {
                  "margin-bottom": "0 !important",
                  ".form-control-label": {
                    "margin-bottom": "4px"
                  },
                  ".form-control": {
                    "padding": "14px 16px",
                    "background-color": "transparent",
                    "border": "none !important",
                    "border-bottom": "1px solid @inputBorder !important",
                    "box-shadow": "none",
                    "margin-bottom": "24px",
                    "@media (max-width: 992px)": {
                      "margin-bottom": "16px"
                    },
                    "&::placeholder": {
                      "color": "@inputColor"
                    },
                    "&:hover, &:focus": {
                      "border": "none !important",
                      "border-bottom": "1px solid @activeColor !important"
                    }
                  },
                  "textarea": {
                    "min-height": "100px"
                  },
                  ".form-check": {
                    "padding-left": "2.1em",
                    ".form-check-input": {
                      "background-color": "@inputBorder",
                      "border-color": "@inputBorder"
                    }
                  }
                },
                ".mbr-section-btn": {
                  "width": "100%",
                  ".btn": {
                    "margin-bottom": "0",
                    "margin-right": "0",
                    "margin-top": "0",
                    "width": "100%",
                    "justify-content": "space-between"
                  }
                }
              }
            },
            ".mbr-label": {
              "color": "#ffffff"
            },
            ".mbr-section-title": {
              "color": "#ffffff"
            },
            ".mbr-text": {
              "color": "#ffffff"
            },
            "label": {
              "color": "#ffffff"
            }
          },
          "_cid": "vaKsw5baY9",
          "_anchor": "form01-7e",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
