        {
          "_name": "features08",
          "_sourceTheme": "carm4",
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 15px)",
              "padding-bottom": "(@paddingBottom * 15px)"
            },
            "& when (@bg-type = \"color\")": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-section-subtitle": {
              "color": "#01c38d",
              "text-align": "center"
            },
            ".mbr-section-title": {
              "text-align": "center",
              "color": "#ffffff"
            },
            ".card": {
              ".card-wrapper": {
                "overflow": "hidden",
                "height": "100%",
                "color": "#ffffff",
                "padding": "0",
                ".card-img": {
                  "position": "relative",
                  ".price-label": {
                    "padding": "11px",
                    "left": "auto",
                    "top": "auto",
                    "bottom": "-20px",
                    "background-color": "@priceLabelBgColor",
                    "z-index": "100",
                    "position": "absolute",
                    ".price-text": {
                      "padding": "0",
                      "margin": "0",
                      "&.display-4": {
                        "line-height": "1.5"
                      }
                    }
                  }
                },
                ".card-box": {
                  "padding": "1.5rem",
                  "background-color": "@cardBg",
                  ".card-title": {
                    "color": "#ffffff",
                    "margin": "0",
                    "line-height": "1.3",
                    "padding-bottom": "1rem",
                    "text-align": "left"
                  },
                  ".card-text": {
                    "color": "#ffffff"
                  },
                  ".date": {
                    "color": "#a1a1a1",
                    "margin-bottom": "0"
                  },
                  ".link": {
                    "&.display-4": {
                      ".mbr-iconfont": {
                        "font-size": "0.9rem"
                      }
                    },
                    ".mbr-iconfont": {
                      "align-self": "center",
                      "color": "@dangerColor",
                      "margin-left": "0.5rem"
                    }
                  }
                }
              }
            },
            ".card .card-wrapper .card-img .price-label .price-text": {
              "color": "#ffffff"
            }
          },
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"features08\" group=\"Features\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax, 'mbr-fullscreen': fullScreen}\">\n\n    <mbr-parameters>\n        <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"9\" step=\"1\" value=\"1\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"9\" step=\"1\" value=\"1\" condition=\"fullScreen == false\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubTitle\">\n        <input type=\"checkbox\" title=\"Main Title\" name=\"showMaintitle\">\n        <input type=\"checkbox\" title=\"Cards Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Cards Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Date\" name=\"showDate\">\n        <input type=\"checkbox\" title=\"Links\" name=\"showLinks\" checked>\n        <input type=\"checkbox\" title=\"Labels\" name=\"showPriceLabels\" checked>\n        <select title=\"Cards\" name=\"cardsAmount\">\n            <option value=\"1\">1</option>\n            <option value=\"2\" selected>2</option>\n            <option value=\"3\">3</option>\n        </select>\n        <input type=\"color\" title=\"Label Bg\" name=\"priceLabelBgColor\" value=\"#0e0f2d\" condition=\"showPriceLabels\">\n        <input type=\"color\" title=\"Card Bg\" name=\"cardBg\" value=\"#0e0f2d\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" value=\"@PROJECT_PATH@/assets/images/background3.jpg\" title=\"Image\">\n            <input type=\"color\" value=\"#0c0d25\" title=\"Color\" selected>\n            <input type=\"video\" value=\"https://www.youtube.com/watch?v=9morbKMwCu4\" title=\"Video\">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Color\" name=\"overlayColor\" value=\"#000000\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n        <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n    <div mbr-class=\"{'container-fluid': fullWidth, 'container': !fullWidth }\">\n        <div class=\"row justify-content-center\">\n            <div class=\"col-md-12\">\n                <h3 class=\"mbr-section-subtitle align-center mbr-white mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showSubTitle\" data-app-selector=\".mbr-section-subtitle\">Producciones</h3>\n                <h2 class=\"mbr-section-title pb-2 mbr-bold mbr-white mbr-fonts-style align-left\" mbr-theme-style=\"display-2\" mbr-if=\"showMaintitle\" data-app-selector=\".mbr-section-title\">REPERTORIO</h2>\n            </div>\n        </div>\n        <div class=\"row row-content justify-content-center\">\n            <div class=\"card p-3 col-12 col-md-6\" mbr-class=\"{'col-lg-4': cardsAmount == '3'|| cardsAmount =='5'|| cardsAmount== '6'}\" mbr-if=\"cardsAmount > 0\">\n                <div class=\"card-wrapper\">\n                    <div class=\"card-img\">\n                        <img src=\"@PROJECT_PATH@/assets/images/raga-180525-208-1106x714.jpg\" title alt>\n                        <div class=\"price-label\" mbr-if=\"showPriceLabels\">\n                            <p class=\"mbr-text mbr-fonts-style price-text\" mbr-theme-style=\"display-4\" data-app-selector=\".card .card-wrapper .card-img .price-label .price-text\">Presentación 1</p>\n                        </div>\n                    </div>\n                    <div class=\"card-box\">\n                        <h4 class=\"card-title mbr-fonts-style mbr-bold\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\" data-app-selector=\".card .card-wrapper .card-box .card-title, .link\">Raga - Concierto&nbsp;</h4>\n                        <p class=\"mbr-text mbr-fonts-style card-text mbr-normal\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".card .card-wrapper .card-box .card-text, .link\">Texto Uno</p>\n                        <p class=\"mbr-text mbr-fonts-style date mbr-normal\" mbr-theme-style=\"display-4\" mbr-if=\"showDate\" data-app-selector=\".card .card-wrapper .card-box .date, .link\">\n                            Ver más</p>\n                        <p class=\"mbr-text link mbr-fonts-style align-left\" mbr-theme-style=\"display-4\" mbr-if=\"showLinks\" data-app-selector=\".card .card-wrapper .card-box .mbr-text\">\n                            <a href=\"Archivo.html#article11-3v\" class=\"text-white\">Ver más</a><span class=\"mobi-mbri mobi-mbri-arrow-next mbr-iconfont\" style=\"color: rgb(33, 37, 241);\"></span></p>\n                    </div>\n                </div>\n            </div>\n\n            <div class=\"card p-3 col-12 col-md-6\" mbr-class=\"{'col-lg-4': cardsAmount == '3'|| cardsAmount =='5'|| cardsAmount== '6'}\" mbr-if=\"cardsAmount > 1\">\n                <div class=\"card-wrapper\">\n                    <div class=\"card-img\">\n                        <img src=\"@PROJECT_PATH@/assets/images/22-musica-de-camara-1106x719.jpg\" title alt>\n                        <div class=\"price-label\" mbr-if=\"showPriceLabels\">\n                            <p class=\"mbr-text mbr-fonts-style price-text\" mbr-theme-style=\"display-4\" data-app-selector=\".card .card-wrapper .card-img .price-label .price-text\">Presentación 2<br></p>\n                        </div>\n                    </div>\n                    <div class=\"card-box\">\n                        <h4 class=\"card-title mbr-fonts-style mbr-bold\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\" data-app-selector=\".card .card-wrapper .card-box .card-title, .link\">Música de cámara</h4>\n                        <p class=\"mbr-text mbr-fonts-style card-text mbr-normal\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".card .card-wrapper .card-box .card-text, .link\">\n                            Texto Dos</p>\n                        <p class=\"mbr-text mbr-fonts-style date mbr-normal\" mbr-theme-style=\"display-4\" mbr-if=\"showDate\" data-app-selector=\".card .card-wrapper .card-box .date, .link\">\n                            Ver más\n                        </p>\n                        <p class=\"mbr-text link mbr-fonts-style align-left\" mbr-theme-style=\"display-4\" mbr-if=\"showLinks\">\n                            <a href=\"Archivo.html#content3-7n\" class=\"text-white\">Ver más</a><span class=\"mobi-mbri mobi-mbri-arrow-next mbr-iconfont\" style=\"color: rgb(33, 37, 241);\"></span></p>\n                    </div>\n                </div>\n            </div>\n\n            <div class=\"card p-3 col-12 col-md-6\" mbr-class=\"{'col-lg-4': cardsAmount == '3'|| cardsAmount =='5'|| cardsAmount== '6'}\" mbr-if=\"cardsAmount > 2\">\n                <div class=\"card-wrapper\">\n                    <div class=\"card-img\">\n                        <a href=\"Frida.html\"><img src=\"@PROJECT_PATH@/assets/images/frida07-713x475.jpg\" title alt></a>\n                        <div class=\"price-label\" mbr-if=\"showPriceLabels\">\n                            <p class=\"mbr-text mbr-fonts-style price-text\" mbr-theme-style=\"display-4\" data-app-selector=\".card .card-wrapper .card-img .price-label .price-text\"><i>\n                                .\n                            </i></p>\n                        </div>\n                    </div>\n                    <div class=\"card-box\">\n                        <h4 class=\"card-title mbr-fonts-style mbr-bold\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\" data-app-selector=\".card .card-wrapper .card-box .card-title, .link\">.</h4>\n                        <p class=\"mbr-text mbr-fonts-style card-text mbr-normal\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".card .card-wrapper .card-box .card-text, .link\">\n                            .\n                        </p>\n                        <p class=\"mbr-text mbr-fonts-style date mbr-normal\" mbr-theme-style=\"display-4\" mbr-if=\"showDate\" data-app-selector=\".card .card-wrapper .card-box .date, .link\">\n                            Ver más\n                        </p>\n                        <p class=\"mbr-text link mbr-fonts-style align-left\" mbr-theme-style=\"display-4\" mbr-if=\"showLinks\">.<span class=\"mobi-mbri mobi-mbri-arrow-next mbr-iconfont\" style=\"color: rgb(1, 195, 141);\"></span></p>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_isUserblock": true,
          "_cid": "vaHlUZ0ZwT",
          "_anchor": "features08-5j",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "_name": "footer01",
          "_sourceTheme": "tokenm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"footer01 tokenm5\" group=\"Footer\" global once=\"footers\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"2\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"2\" condition=\"fullScreen == false\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\" checked>\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Navigation\" name=\"showNav\">\n        <input type=\"color\" title=\"Active Color\" value=\"#cbff5b\" name=\"active\" condition=\"showNav\" selected>\n        <input type=\"checkbox\" title=\"Copyright\" name=\"showCopy\" checked>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@ADDONS_PATH@/tokenm5/components/_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#000000\" selected>\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@ADDONS_PATH@/tokenm5/components/_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#000000\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n            <div class=\"col-12 col-lg-5 card\" mbr-if=\"showNav\">\n                <div class=\"nav-wrapper\">\n                    <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".list, .item-wrap, .nav-wrapper\" data-multiline mbr-article>\n                        <li class=\"item-wrap\">Home</li>\n                        <li class=\"item-wrap\">Events</li>\n                        <li class=\"item-wrap\">Services</li>\n                    </ul>\n                </div>\n            </div>\n            <div class=\"col-12 col-lg-5 card\" mbr-if=\"showCopy\">\n                <p class=\"mbr-copy mbr-fonts-style\" data-app-selector=\".mbr-copy\" mbr-theme-style=\"display-4\">\n                    Raga Ensamble de Percusiones de México . 2026 . Todos los derechos reservados.\n                </p>\n            </div>\n        </div>\n    </div>\n</section>",
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".row": {
              "justify-content": "center"
            },
            ".card": {
              "justify-content": "center"
            },
            ".mbr-copy": {
              "margin-bottom": "0",
              "color": "#ffffff",
              "text-align": "center"
            },
            ".nav-wrapper": {
              "@media (max-width: 992px)": {
                "margin-bottom": "30px"
              },
              ".list": {
                "display": "inline-flex",
                "flex-wrap": "wrap",
                "justify-content": "center",
                "margin": "0",
                "padding": "0",
                "list-style-type": "none",
                ".item-wrap": {
                  "padding": "5px 32px",
                  "margin-bottom": "0",
                  "transition": "all .3s ease",
                  "cursor": "pointer",
                  "&:hover, &:focus": {
                    "color": "@active"
                  }
                }
              }
            },
            ".list, .nav-wrapper": {
              "color": "#ffffff",
              "text-align": "center"
            }
          },
          "_cid": "vaKtyElioi",
          "_anchor": "footer01-7f",
          "_protectedParams": [],
          "_global": true,
          "_once": "footers",
          "_params": {}
        }
      ]
    },
    "Espectaculos_E.html": {
      "settings": {
        "title": "ESPECTACULOS",
        "meta_descr": "",
        "header_custom": "",
        "footer_custom": "",
        "html_before": "",
        "order": "3"
      },
      "components": [
        {
          "alias": false,
          "_styles": {
            "& when not (@sticky)": {
              ".navbar-dropdown": {
                "position": "relative !important"
              },
              "& when (@transparent)": {
                ".navbar-dropdown": {
                  "position": "absolute !important"
                }
              }
            },
            "& when (@sticky)": {
              "z-index": "1000",
              "width": "100%",
              "& when not (@transparent)": {
                "position": "relative",
                "min-height": "60px"
              },
              "nav.navbar": {
                "position": "fixed"
              }
            },
            ".navbar": {
              "min-height": "70px",
              "transition": "all 0.3s",
              "&:not(.navbar-short)": {},
              "& when not (@transparent)": {
                "box-shadow": "0 1px 3px 0 rgba(0, 0, 0, 0.1)",
                "background": "@menuBgColor"
              },
              "& when (@transparent)": {
                "background": "rgba(red(@menuBgColor), green(@menuBgColor), blue(@menuBgColor), @opacity)"
              },
              "&.opened": {
                "transition": "all 0.3s"
              },
              ".dropdown-item": {
                "padding": "0.5rem 1.8rem"
              },
              ".navbar-logo img": {
                "width": "auto"
              },
              ".navbar-collapse": {
                "justify-content": "flex-end",
                "z-index": "1"
              },
              "&.collapsed": {
                "justify-content": "center",
                ".nav-item .nav-link::before": {
                  "display": "none"
                },
                ".mbr-text": {
                  "display": "initial",
                  "padding-right": "0",
                  "padding": "10px"
                },
                "&.opened": {
                  ".dropdown-menu": {
                    "top": "0"
                  },
                  "@media (min-width: 992px)": {
                    "&:not(.navbar-short) .navbar-collapse when (@showLogo)": {
                      "max-height": "~\"calc(98.5vh - @{logoSize}rem)\""
                    }
                  }
                },
                ".dropdown-menu": {
                  ".dropdown-submenu": {
                    "left": "0 !important"
                  },
                  ".dropdown-item:after": {
                    "right": "auto"
                  },
                  ".dropdown-toggle[data-toggle=\"dropdown-submenu\"]:after": {
                    "margin-left": "0.5rem",
                    "margin-top": "0.2rem",
                    "border-top": "0.35em solid",
                    "border-right": "0.35em solid transparent",
                    "border-left": "0.35em solid transparent",
                    "border-bottom": "0",
                    "top": "41%"
                  }
                },
                "ul.navbar-nav": {
                  "li": {
                    "margin": "auto"
                  }
                },
                ".dropdown-menu .dropdown-item": {
                  "padding": "0.25rem 1.5rem",
                  "text-align": "center"
                },
                ".icons-menu": {
                  "padding-left": "0",
                  "padding-right": "0"
                }
              },
              "@media (max-width: 991px)": {
                ".nav-item .nav-link::before": {
                  "display": "none"
                },
                "&.opened": {
                  ".dropdown-menu": {
                    "top": "0"
                  }
                },
                ".dropdown-menu": {
                  ".dropdown-submenu": {
                    "left": "0 !important"
                  },
                  ".dropdown-item:after": {
                    "right": "auto"
                  },
                  ".dropdown-toggle[data-toggle=\"dropdown-submenu\"]:after": {
                    "margin-left": "0.5rem",
                    "margin-top": "0.2rem",
                    "border-top": "0.35em solid",
                    "border-right": "0.35em solid transparent",
                    "border-left": "0.35em solid transparent",
                    "border-bottom": "0",
                    "top": "40%"
                  }
                },
                ".navbar-logo": {
                  "img": {
                    "height": "3rem !important"
                  }
                },
                "ul.navbar-nav": {
                  "li": {
                    "margin": "auto"
                  }
                },
                ".dropdown-menu .dropdown-item": {
                  "padding": "0.25rem 1.5rem !important",
                  "text-align": "center"
                },
                ".navbar-brand": {
                  "flex-shrink": "initial",
                  "flex-basis": "auto",
                  "word-break": "break-word",
                  "padding-right": "2rem"
                },
                ".navbar-toggler": {
                  "flex-basis": "auto"
                },
                ".icons-menu": {
                  "padding-left": "0",
                  "padding-top": "0.5rem",
                  "padding-bottom": "0.5rem"
                }
              },
              "&.navbar-short": {
                "min-height": "60px",
                ".navbar-logo": {
                  "img": {
                    "height": "2.5rem !important"
                  }
                },
                ".navbar-brand": {
                  "min-height": "60px",
                  "padding": "0"
                }
              }
            },
            ".dropdown-item:before": {
              "font-family": "Moririse2 !important",
              "content": "\"\\e966\"",
              "display": "inline-block",
              "width": "0",
              "position": "absolute",
              "left": "1rem",
              "top": "0.5rem",
              "margin-right": "0.5rem",
              "line-height": "1",
              "font-size": "inherit",
              "vertical-align": "middle",
              "text-align": "center",
              "overflow": "hidden",
              "transform": "scale(0, 1)",
              "transition": "all 0.25s ease-in-out"
            },
            ".dropdown-menu": {
              "padding": "0",
              "border-radius": "0",
              "box-shadow": "0 1px 3px 0 rgba(0, 0, 0, 0.1)",
              "margin-top": "0px"
            },
            ".dropdown-item": {
              "&:hover, &:focus": {
                "color": "@primaryColor !important"
              }
            },
            ".nav-dropdown .link": {
              "padding": "13px 0em !important",
              "font-weight": "500"
            },
            ".nav-dropdown .link.dropdown-toggle::after": {
              "margin-left": "0.5rem",
              "margin-top": "0.2rem"
            },
            ".nav-link": {
              "position": "relative",
              "padding": "0",
              "transition": "all 0.5s ease-in-out",
              "padding-bottom": "13px !important"
            },
            ".container": {
              "display": "flex",
              "margin": "auto"
            },
            ".iconfont-wrapper": {
              "font-size": "1.5rem",
              "padding-right": "0.5rem"
            },
            ".dropdown-menu, .navbar.opened": {
              "background": "@menuBgColor !important"
            },
            ".nav-item:focus, .nav-link:focus": {
              "outline": "none"
            },
            ".dropdown .dropdown-menu .dropdown-item": {
              "width": "auto",
              "transition": "all 0.25s ease-in-out",
              "&::after": {
                "right": "0.5rem"
              },
              ".mbr-iconfont": {
                "margin-right": "0.5rem",
                "vertical-align": "sub",
                "&:before": {
                  "display": "inline-block",
                  "transform": "scale(1, 1)",
                  "transition": "all 0.25s ease-in-out"
                }
              }
            },
            ".collapsed": {
              ".dropdown-menu .dropdown-item:before": {
                "display": "none"
              },
              ".dropdown .dropdown-menu .dropdown-item": {
                "padding": "0.235em 1.5em 0.235em 1.5em !important",
                "transition": "none",
                "margin": "0 !important"
              }
            },
            ".navbar-brand": {
              "min-height": "70px",
              "flex-shrink": "0",
              "align-items": "center",
              "margin-right": "0",
              "padding": "10px 0",
              "transition": "all 0.3s",
              "word-break": "break-word",
              "z-index": "1",
              ".navbar-caption": {
                "line-height": "inherit !important"
              },
              ".navbar-logo a": {
                "outline": "none"
              }
            },
            ".dropdown-item.active, .dropdown-item:active": {
              "background-color": "transparent"
            },
            ".navbar-expand-lg .navbar-nav .nav-link": {
              "padding": "0"
            },
            ".nav-dropdown .link.dropdown-toggle": {
              "margin-right": "1.667em",
              "&[aria-expanded=\"true\"]": {
                "margin-right": "0",
                "padding": "0.667em 1.667em"
              }
            },
            ".navbar.navbar-expand-lg .dropdown": {
              ".dropdown-menu": {
                "background": "@menuBgColor",
                ".dropdown-submenu": {
                  "margin": "0",
                  "left": "100%"
                }
              }
            },
            ".navbar .dropdown.open > .dropdown-menu": {
              "display": "block"
            },
            "ul.navbar-nav": {
              "flex-wrap": "wrap",
              "padding-left": "20px"
            },
            ".navbar-buttons": {
              "text-align": "center",
              "min-width": "170px"
            },
            "button.navbar-toggler": {
              "outline": "none",
              "width": "31px",
              "height": "20px",
              "cursor": "pointer",
              "transition": "all 0.2s",
              "position": "relative",
              "align-self": "center",
              ".hamburger span": {
                "position": "absolute",
                "right": "0",
                "width": "30px",
                "height": "2px",
                "border-right": "5px",
                "background-color": "@hamburgerColor",
                "&:nth-child(1)": {
                  "top": "0",
                  "transition": "all 0.2s"
                },
                "&:nth-child(2)": {
                  "top": "8px",
                  "transition": "all 0.15s"
                },
                "&:nth-child(3)": {
                  "top": "8px",
                  "transition": "all 0.15s"
                },
                "&:nth-child(4)": {
                  "top": "16px",
                  "transition": "all 0.2s"
                }
              }
            },
            "nav.opened .hamburger span": {
              "&:nth-child(1)": {
                "top": "8px",
                "width": "0",
                "opacity": "0",
                "right": "50%",
                "transition": "all 0.2s"
              },
              "&:nth-child(2)": {
                "transform": "rotate(45deg)",
                "transition": "all 0.25s"
              },
              "&:nth-child(3)": {
                "transform": "rotate(-45deg)",
                "transition": "all 0.25s"
              },
              "&:nth-child(4)": {
                "top": "8px",
                "width": "0",
                "opacity": "0",
                "right": "50%",
                "transition": "all 0.2s"
              }
            },
            ".navbar-dropdown": {
              "& when (@sticky)": {
                "position": "fixed"
              }
            },
            "a.nav-link": {
              "display": "flex",
              "align-items": "center",
              "justify-content": "center"
            },
            ".icons-menu": {
              "flex-wrap": "nowrap",
              "display": "flex",
              "justify-content": "flex-end",
              "padding-left": "9rem",
              "padding-top": "0.3rem",
              "text-align": "center",
              "min-width": "340px !important"
            },
            "@media screen and (~'-ms-high-contrast: active'), (~'-ms-high-contrast: none')": {
              ".navbar": {
                "height": "70px",
                "&.opened": {
                  "height": "auto"
                }
              },
              ".nav-item .nav-link:hover::before": {
                "width": "175%",
                "max-width": "calc(100% ~\"+\" 2rem)",
                "left": "-1rem"
              }
            },
            "a": {
              "display": "inline",
              "font-weight": "400 !important"
            },
            "img": {
              "display": "inline",
              "padding-right": "10px"
            },
            ".dropdown-toggle:after": {
              "display": "none"
            },
            ".navbar .dropdown-item": {
              "display": "block",
              "border-radius": "0",
              "padding-top": "9px",
              "padding-bottom": "9px"
            },
            ".dropdown-item:hover": {
              "color": "#75dbcd !important"
            },
            "@media (max-width: 990px)": {
              ".dropdown-menu": {
                "margin-top": "0px"
              },
              ".nav-dropdown .link": {
                "margin": "0 !important"
              }
            },
            ".mbr-buttons": {
              "margin": "20px -6px 20px"
            },
            ".nav-item:last-child": {
              "margin-right": "0"
            },
            "@media (max-width: 970px)": {
              "ul li": {
                "height": "45px",
                "display": "list-item"
              }
            },
            ".navbar-collapse.collapsing .nav-item": {
              "height": "45px"
            },
            ".navbar-collapse.collapse.show .nav-item": {
              "height": "45px"
            },
            ".navbar-collapse.collapse.show ul li": {
              "display": "list-item"
            },
            ".mbr-iconfont": {
              "margin-left": "-5px",
              "margin-right": "7px"
            },
            ".btn": {
              "transition": "color 350ms ease, transform 300ms ease, border 300ms ease, background-color 300ms ease, -webkit-transform 300ms ease !important",
              "padding": "1rem 1.5625rem !important",
              "display": "inline-block",
              "line-height": "20px",
              "transform-style": "preserve-3d !important"
            },
            ".btn when (@isRoundedButtons)": {
              "border-radius": "1000px !important"
            },
            ".navbar.collapsed .icons-menu": {
              "display": "flex",
              "flex-direction": "column",
              ".top": {
                "margin-top": "15px"
              }
            },
            ".dropdown-toggle[data-toggle=\"dropdown-submenu\"]:after": {
              "margin-left": "0.5rem",
              "margin-top": "0.2rem",
              "border-top": "0.35em solid",
              "border-right": "0.35em solid transparent",
              "border-left": "0.35em solid transparent",
              "border-bottom": "0",
              "top": "41%"
            },
            ".dropdown-toggle::after": {
              "display": "inline-block",
              "margin-left": ".255em",
              "vertical-align": ".255em",
              "content": "\"\"",
              "border-top": ".3em solid",
              "border-right": ".3em solid transparent",
              "border-bottom": "0",
              "border-left": ".3em solid transparent"
            },
            ".dropdown-item:focus": {
              "color": "#75dbcd !important"
            },
            "@media (max-width: 945px)": {
              ".icons-menu": {
                "display": "flex",
                "flex-direction": "column"
              },
              ".top": {
                "margin-top": "25px"
              }
            },
            "@media (min-width: 992px)": {
              ".container, .container-fluid": {
                "flex-wrap": "nowrap"
              }
            },
            "li:last-child": {
              "margin-right": "0"
            },
            "& when (@collapsed)": {
              "ul.navbar-nav": {
                "padding-left": "0"
              },
              ".container, .container-fluid": {
                "flex-wrap": "inherit !important"
              }
            },
            "@media (max-width: 989px)": {
              "ul.navbar-nav": {
                "padding-left": "0"
              }
            },
            "@media (max-width: 430px)": {
              ".icons-menu": {
                "min-width": "initial !important"
              },
              "a.btn": {
                "margin-top": "10px"
              }
            },
            "a.btn > span": {
              "margin-left": "0.5rem"
            },
            ".nav-item": {
              "position": "relative"
            },
            ".nav-item:hover": {
              ".nav-link": {
                "color": "#c0f22c !important"
              }
            },
            "a.btn": {
              "padding": "13px 30px !important",
              "transition": "all .5s",
              "font-weight": "600 !important",
              "min-width": "146px"
            },
            "li.nav-item": {
              "padding": "13px 40px !important"
            },
            "a.btn:hover": {
              "color": "#000000 !important",
              "background-color": "#ffffff !important",
              "border-color": "#ffffff !important"
            },
            ".mbr-text": {
              "display": "flex",
              "align-items": "center",
              "padding-right": "25px",
              "min-width": "150px"
            },
            ".mbr-text, .button-align": {
              "color": "#ffffff"
            },
            ".container-fluid": {
              "border-bottom": "1px solid #f2f2f2",
              "margin": "0 15px"
            },
            "@media (max-width: 1220px)": {
              ".icons-menu": {
                "padding-left": "4rem"
              },
              "li.nav-item": {
                "padding": "13px 20px !important"
              }
            },
            "@media (max-width: 992px)": {
              ".mbr-text": {
                "display": "initial",
                "padding-right": "0",
                "padding": "10px"
              }
            }
          },
          "_name": "menu1",
          "_sourceTheme": "yogam5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"menu1\" group=\"Menu\" plugins=\"DropDown, TouchSwipe\" always-top global once=\"menu\" not-draggable position-absolute>\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" name=\"fullWidth\" title=\"Full Width\" checked>\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Logo\" name=\"showLogo\" checked>\n        <input type=\"range\" title=\"Logo Size\" inline name=\"logoSize\" min=\"2\" max=\"6\" step=\"0.1\" value=\"3.3\" condition=\"showLogo\">\n        <input type=\"checkbox\" title=\"Brand Name\" name=\"showBrand\">\n        <input type=\"checkbox\" title=\"Menu Items\" name=\"showItems\" checked>\n        <input type=\"checkbox\" title=\"Button\" name=\"showButton\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\">\n        <header>Styles</header>\n        <input type=\"checkbox\" title=\"Sticky\" name=\"sticky\">\n        <input type=\"checkbox\" title=\"Collapsed\" name=\"collapsed\">\n        <input type=\"checkbox\" title=\"Transparent\" name=\"transparent\" checked>\n        <input type=\"range\" title=\"Opacity\" name=\"opacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0\" condition=\"transparent\">\n        <input type=\"color\" title=\"Color\" name=\"menuBgColor\" value=\"#0e0f2d\">\n        <input type=\"color\" title=\"Hamburger\" name=\"hamburgerColor\" value=\"#ffffff\">\n    </mbr-parameters>\n\n    <nav class=\"navbar navbar-dropdown\" mbr-class=\"{'navbar-fixed-top':sticky,\n                     'navbar-expand-lg':!collapsed,\n                     'collapsed':collapsed}\">\n        <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n            <div class=\"navbar-brand\">\n                <span mbr-if=\"showLogo\" class=\"navbar-logo\">\n                    <a href=\"index.html\">\n                        <img src=\"@PROJECT_PATH@/assets/images/rag-png-mesa-de-trabajo-1-105x105.png\" alt mbr-style=\"{'height': logoSize + 'rem'}\">\n                    </a>\n                </span>\n                <span mbr-if=\"showBrand\" mbr-buttons mbr-theme-style=\"display-4\" class=\"navbar-caption-wrap\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd,-mbrBtnRemove,-iconFont\"><a class=\"navbar-caption text-white\" data-app-selector=\".navbar-caption\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">YogaM5</a></span>\n            </div>\n            <button class=\"navbar-toggler\" type=\"button\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-target=\"#navbarSupportedContent\" data-bs-target=\"#navbarSupportedContent\" aria-controls=\"navbarNavAltMarkup\" aria-expanded=\"false\" aria-label=\"Toggle navigation\" mbr-if=\"showItems || showIcons || showButtons\">\n                <div class=\"hamburger\">\n                    <span></span>\n                    <span></span>\n                    <span></span>\n                    <span></span>\n                </div>\n            </button>\n            <div class=\"collapse navbar-collapse\" id=\"navbarSupportedContent\" mbr-if=\"showItems || showIcons || showButtons\">\n                <ul mbr-menu class=\"navbar-nav nav-dropdown\" mbr-theme-style=\"display-4\" mbr-if=\"showItems\" mbr-class=\"{'nav-right': !showButtons,'navbar-nav-top-padding': isPublish && !showBrand && !showLogo}\"><li class=\"nav-item\"><a class=\"nav-link link text-white text-primary\" href=\"Raga_E.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" aria-expanded=\"false\">Raga<div class=\"line-animation\"></div></a></li>\n                    <li class=\"nav-item\"><a class=\"nav-link link text-white text-primary\" href=\"Espectaculos_E.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" aria-expanded=\"false\">Espectáculos</a></li>\n                    <li class=\"nav-item\"><a class=\"nav-link link text-white text-primary\" href=\"Educacion_E.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" aria-expanded=\"false\">Educación</a></li>\n                    <li class=\"nav-item\"><a class=\"nav-link link text-white text-primary\" href=\"Galeria_E.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" aria-expanded=\"false\">Galería</a></li></ul>\n                <div class=\"icons-menu\">\n                    <p class=\"mbr-text mbr-fonts-style\" mbr-if=\"showText\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-text, .button-align\">Raga2</p>\n                    <div class=\"mbr-section-btn\" mbr-if=\"showButton\" data-toolbar=\"-mbrBtnAdd, -mbrBtnMove, -mbrBtnRemove\" mbr-buttons mbr-theme-style=\"display-4\"><a class=\"btn btn-secondary-outline\" href=\"index.html#bottom\" data-app-placeholder=\"Type Text\">Contacto</a></div>\n                </div>\n            </div>\n        </div>\n    </nav>\n</section>",
          "_cid": "vaHlWw9k0E",
          "_anchor": "menu1-5p",
          "_protectedParams": [],
          "_global": true,
          "_once": "menu",
          "_params": {}
        },
        {
          "_name": "features03",
          "_sourceTheme": "promotionm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"features03 promotionm5\" group=\"Features\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"5\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"5\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Label\" name=\"showLabel\">\n        <input type=\"checkbox\" title=\"Icon\" name=\"showIcon\" checked condition=\"showLabel\">\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\">\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\">\n        <header>Cards</header>\n        <input type=\"checkbox\" title=\"Date\" name=\"showDate\">\n        <input type=\"checkbox\" title=\"Title\" name=\"showCardTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showCardText\">\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showCardButtons\">\n        <input type=\"checkbox\" title=\"Icon\" name=\"showCardIcon\">\n        <input type=\"color\" title=\"Icon Bg\" value=\"#1f1f1f\" name=\"iconBg\" selected condition=\"showCardIcon\">\n        <input type=\"color\" title=\"Active Color\" value=\"#ffffff\" name=\"activeColor\" selected condition=\"showCardIcon\">\n        <input type=\"color\" title=\"Active Bg\" value=\"#2125f1\" name=\"activeBg\" selected condition=\"showCardIcon\">\n        <input type=\"color\" title=\"Active Overlay\" name=\"overColor\" value=\"#2125f1\">\n        <input type=\"range\" inline title=\"Overlay Opacity\" name=\"overOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.3\">\n        <input type=\"checkbox\" title=\"Invert\" name=\"showInvert\" checked>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@ADDONS_PATH@/promotionm5/components/_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#0c0d25\" selected>\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@ADDONS_PATH@/promotionm5/components/_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row justify-content-center\">\n            <div class=\"col-12 col-lg-10\">\n                <div class=\"content-wrapper\">\n                    <div class=\"row content-wrap\" mbr-if=\"showLabel || showTitle || showText || showButtons\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n                        <div class=\"col-12 col-lg-3 card\">\n                            <div class=\"label-wrapper\" mbr-if=\"showLabel\">\n                                <div class=\"label-wrap\">\n                                    <div class=\"iconfont-wrapper\" mbr-if=\"showIcon\">\n                                        <span mbr-icon class=\"card-icon mbr-iconfont mobi-mbri-calendar mobi-mbri\" data-app-selector=\".card-icon\" style=\"color: rgb(31, 31, 31); fill: rgb(31, 31, 31);\"></span>\n                                    </div>\n                                    <p class=\"mbr-label mbr-fonts-style\" data-app-selector=\".mbr-label, .label-wrapper\" mbr-theme-style=\"display-7\">\n                                        Momentum\n                                    </p>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"col-12 col-lg-5 card\">\n                            <div class=\"text-wrapper\">\n                                <div class=\"title-wrapper\">\n                                    <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title, .title-wrapper, .main-btn\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\">\n                                        Espectáculos</h2>\n                                </div>\n                                <div class=\"text-wrap\">\n                                    <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .text-wrap\">\n                                        Our events are designed to inspire growth, share expertise, and turn ideas into\n                                        practical marketing solutions.\n                                    </p>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"col-12 col-lg-4 card\">\n                            <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn main-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\">\n                                <a class=\"btn btn-black\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\n                                    Learn more\n                                </a>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"row items-wrapper justify-content-center\">\n                        <div class=\"col-12 col-lg-6 item features-without-image\">\n                            <div class=\"item-wrapper\">\n                                <div class=\"image-wrapper\">\n                                    <div class=\"image-overlay card-wrap\"></div>\n                                    <div class=\"image-blur card-wrap\"></div>\n                                    <div class=\"item-img card-wrap\">\n                                        \n                                            <img src=\"@PROJECT_PATH@/assets/images/17-musica-teatral-1189x771.jpg\" alt>\n                                        \n                                    </div>\n                                    <div class=\"image-wrap\">\n                                        \n                                            <img src=\"@PROJECT_PATH@/assets/images/rag-png-mesa-de-trabajo-1-452x452.png\" alt>\n                                        \n                                    </div>\n                                </div>\n                                <div class=\"card-box\">\n                                    <p class=\"item-date mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".item-date\" mbr-if=\"showDate\">\n                                        2030\n                                    </p>\n                                    <div class=\"item-content\">\n                                        <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".item-title, .item-btn\" mbr-if=\"showCardTitle\">Música Teatral</h4>\n                                        <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".item-text\" mbr-if=\"showCardText\">\n                                            A strategy-focused event on scaling brands and increasing revenue\n                                        </p>\n                                        <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn item-btn\" mbr-if=\"showCardButtons\" data-toolbar=\"-mbrBtnMove\">\n                                            <a class=\"btn btn-black-outline\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\n                                                <span class=\"mobi-mbri mobi-mbri-right mbr-iconfont mbr-iconfont-btn\"></span>\n                                                Learn more\n                                            </a>\n                                        </div>\n                                    </div>\n                                    <div class=\"icon-wrapper card-wrap little-radius\" mbr-if=\"showCardIcon\">\n                                        <a href=\"#\">\n                                            <span mbr-icon class=\"card-icons mbr-iconfont mobi-mbri-right mobi-mbri\" data-app-selector=\".card-icons\" style=\"color: rgb(255, 255, 255); fill: rgb(255, 255, 255);\"></span>\n                                        </a>\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"col-12 col-lg-6 item features-without-image\">\n                            <div class=\"item-wrapper\">\n                                <div class=\"image-wrapper\">\n                                    <div class=\"image-overlay card-wrap\"></div>\n                                    <div class=\"image-blur card-wrap\"></div>\n                                    <div class=\"item-img card-wrap\">\n                                        <a href=\"#\">\n                                            <img src=\"@PROJECT_PATH@/assets/images/raga-180525-208-1189x768.jpg\" alt=\"Mobirise Website Builder\">\n                                        </a>\n                                    </div>\n                                    <div class=\"image-wrap\">\n                                        \n                                            <img src=\"@PROJECT_PATH@/assets/images/rag-png-mesa-de-trabajo-1-452x452.png\" alt>\n                                        \n                                    </div>\n                                </div>\n                                <div class=\"card-box\">\n                                    <p class=\"item-date mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".item-date\" mbr-if=\"showDate\">\n                                        2030\n                                    </p>\n                                    <div class=\"item-content\">\n                                        <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".item-title, .item-btn\" mbr-if=\"showCardTitle\">Música de cámara</h4>\n                                        <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".item-text\" mbr-if=\"showCardText\">\n                                            Hands-on sessions exploring branding, content, and storytelling.\n                                        </p>\n                                        <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn item-btn\" mbr-if=\"showCardButtons\" data-toolbar=\"-mbrBtnMove\">\n                                            <a class=\"btn btn-black-outline\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\n                                                <span class=\"mobi-mbri mobi-mbri-right mbr-iconfont mbr-iconfont-btn\"></span>\n                                                Learn more\n                                            </a>\n                                        </div>\n                                    </div>\n                                    <div class=\"icon-wrapper card-wrap little-radius\" mbr-if=\"showCardIcon\">\n                                        <a href=\"#\">\n                                            <span mbr-icon class=\"card-icons mbr-iconfont mobi-mbri-right mobi-mbri\" data-app-selector=\".card-icons\" style=\"color: rgb(255, 255, 255); fill: rgb(255, 255, 255);\"></span>\n                                        </a>\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"col-12 col-lg-6 item features-without-image\">\n                            <div class=\"item-wrapper\">\n                                <div class=\"image-wrapper\">\n                                    <div class=\"image-overlay card-wrap\"></div>\n                                    <div class=\"image-blur card-wrap\"></div>\n                                    <div class=\"item-img card-wrap\">\n                                        <a href=\"#\">\n                                            <img src=\"@PROJECT_PATH@/assets/images/26-raga-final-1189x832.jpg\" alt=\"Mobirise Website Builder\">\n                                        </a>\n                                    </div>\n                                    <div class=\"image-wrap\">\n                                        \n                                            <img src=\"@PROJECT_PATH@/assets/images/rag-png-mesa-de-trabajo-1-452x452.png\" alt>\n                                        \n                                    </div>\n                                </div>\n                                <div class=\"card-box\">\n                                    <p class=\"item-date mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".item-date\" mbr-if=\"showDate\">\n                                        2030\n                                    </p>\n                                    <div class=\"item-content\">\n                                        <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".item-title, .item-btn\" mbr-if=\"showCardTitle\">Pop Wuj</h4>\n                                        <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".item-text\" mbr-if=\"showCardText\">\n                                            Deep dives into paid media, analytics, and optimization.\n                                        </p>\n                                        <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn item-btn\" mbr-if=\"showCardButtons\" data-toolbar=\"-mbrBtnMove\">\n                                            <a class=\"btn btn-black-outline\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\n                                                <span class=\"mobi-mbri mobi-mbri-right mbr-iconfont mbr-iconfont-btn\"></span>\n                                                Learn more\n                                            </a>\n                                        </div>\n                                    </div>\n                                    <div class=\"icon-wrapper card-wrap little-radius\" mbr-if=\"showCardIcon\">\n                                        <a href=\"#\">\n                                            <span mbr-icon class=\"card-icons mbr-iconfont mobi-mbri-right mobi-mbri\" data-app-selector=\".card-icons\" style=\"color: rgb(255, 255, 255); fill: rgb(255, 255, 255);\"></span>\n                                        </a>\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"col-12 col-lg-6 item features-without-image\">\n                            <div class=\"item-wrapper\">\n                                <div class=\"image-wrapper\">\n                                    <div class=\"image-overlay card-wrap\"></div>\n                                    <div class=\"image-blur card-wrap\"></div>\n                                    <div class=\"item-img card-wrap\">\n                                        <a href=\"#\">\n                                            <img src=\"@PROJECT_PATH@/assets/images/25-musica-de-camara-1189x752.jpg\" alt=\"Mobirise Website Builder\">\n                                        </a>\n                                    </div>\n                                    <div class=\"image-wrap\">\n                                        \n                                            <img src=\"@PROJECT_PATH@/assets/images/rag-png-mesa-de-trabajo-1-452x452.png\" alt>\n                                        \n                                    </div>\n                                </div>\n                                <div class=\"card-box\">\n                                    <p class=\"item-date mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".item-date\" mbr-if=\"showDate\">\n                                        2030\n                                    </p>\n                                    <div class=\"item-content\">\n                                        <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".item-title, .item-btn\" mbr-if=\"showCardTitle\">Electroacústica y visuales</h4>\n                                        <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".item-text\" mbr-if=\"showCardText\">\n                                            Networking event connecting brands with industry experts.\n                                        </p>\n                                        <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn item-btn\" mbr-if=\"showCardButtons\" data-toolbar=\"-mbrBtnMove\">\n                                            <a class=\"btn btn-black-outline\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\n                                                <span class=\"mobi-mbri mobi-mbri-right mbr-iconfont mbr-iconfont-btn\"></span>\n                                                Learn more\n                                            </a>\n                                        </div>\n                                    </div>\n                                    <div class=\"icon-wrapper card-wrap little-radius\" mbr-if=\"showCardIcon\">\n                                        <a href=\"#\">\n                                            <span mbr-icon class=\"card-icons mbr-iconfont mobi-mbri-right mobi-mbri\" data-app-selector=\".card-icons\" style=\"color: rgb(255, 255, 255); fill: rgb(255, 255, 255);\"></span>\n                                        </a>\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".content-wrap": {
              "margin": "0 -50px 50px",
              ".card": {
                "padding": "0 50px",
                "&:last-child": {
                  "justify-content": "flex-end"
                }
              },
              ".label-wrapper": {
                "margin-bottom": "20px",
                ".label-wrap": {
                  "display": "inline-flex",
                  "flex-wrap": "wrap",
                  "align-items": "center",
                  "gap": "8px",
                  ".iconfont-wrapper": {
                    "display": "flex",
                    ".mbr-iconfont": {
                      "display": "inline-flex",
                      "font-size": "20px"
                    }
                  },
                  ".mbr-label": {
                    "margin-bottom": "0"
                  }
                }
              },
              ".text-wrapper": {
                ".title-wrapper": {
                  ".mbr-section-title": {
                    "margin-bottom": "20px"
                  }
                },
                ".text-wrap": {
                  ".mbr-text": {
                    "display": "inline-flex",
                    "width": "80%",
                    "margin-bottom": "0",
                    "@media (max-width: 992px)": {
                      "width": "100%"
                    }
                  }
                }
              },
              ".main-btn": {
                "margin-top": "20px",
                "margin-bottom": "-9.6px"
              }
            },
            ".items-wrapper": {
              "margin": "0 -10px",
              ".item": {
                "padding": "0 10px",
                "margin-bottom": "50px",
                "@media (max-width: 992px)": {
                  "margin-bottom": "30px",
                  "&:last-child": {
                    "margin-bottom": "0"
                  }
                },
                ".item-wrapper": {
                  "height": "100%",
                  "animation": "none !important",
                  "&:hover, &:focus": {
                    ".image-wrapper": {
                      ".item-img": {
                        "img": {
                          "transform": "scale(1)"
                        }
                      },
                      ".image-overlay": {
                        "opacity": "@overOpacity"
                      },
                      ".image-blur": {
                        "opacity": "1"
                      },
                      ".image-wrap": {
                        "img": {
                          "opacity": "1"
                        }
                      }
                    },
                    ".card-box .icon-wrapper": {
                      "background-color": "@activeBg",
                      ".mbr-iconfont": {
                        "color": "@activeColor !important",
                        "transform": "rotate(0)"
                      }
                    }
                  },
                  ".image-wrapper": {
                    "position": "relative",
                    "display": "flex",
                    "align-items": "center",
                    "justify-content": "center",
                    "margin-bottom": "15px",
                    "animation": "none !important",
                    ".item-img": {
                      "overflow": "hidden",
                      "width": "100%",
                      "img": {
                        "width": "100%",
                        "height": "560px",
                        "object-fit": "cover",
                        "transform": "scale(1.05)",
                        "transition": "all .5s ease",
                        "@media (max-width: 992px)": {
                          "height": "300px"
                        }
                      }
                    },
                    ".image-overlay": {
                      "position": "absolute",
                      "top": "0",
                      "left": "0",
                      "width": "100%",
                      "height": "100%",
                      "background-color": "@overColor",
                      "opacity": "0",
                      "pointer-events": "none",
                      "transition": "all .5s ease",
                      "z-index": "1"
                    },
                    ".image-blur": {
                      "position": "absolute",
                      "top": "0",
                      "left": "0",
                      "width": "100%",
                      "height": "100%",
                      "backdrop-filter": "blur(4px)",
                      "transition": "all .5s ease",
                      "opacity": "0",
                      "pointer-events": "none",
                      "z-index": "1"
                    },
                    ".image-wrap": {
                      "position": "absolute",
                      "z-index": "2",
                      "img": {
                        "height": "200px",
                        "width": "250px",
                        "object-fit": "cover",
                        "z-index": "1",
                        "opacity": "0",
                        "transition": "all .3s ease",
                        "& when (@showInvert)": {
                          "filter": "invert(1)"
                        }
                      }
                    }
                  },
                  ".card-box": {
                    "position": "relative",
                    "display": "flex",
                    "flex-wrap": "wrap",
                    "gap": "5px 20px",
                    "padding": "0 50px 0 10px",
                    "@media (max-width: 992px)": {
                      "display": "block"
                    },
                    ".item-date": {
                      "min-width": "45px",
                      "margin-bottom": "5px",
                      "@media (max-width: 992px)": {
                        "min-width": "auto"
                      }
                    },
                    ".item-content": {
                      ".item-title": {
                        "margin-bottom": "5px"
                      },
                      ".item-text": {
                        "margin-bottom": "0"
                      },
                      ".item-btn": {
                        "margin-top": "10px",
                        "margin-bottom": "-9.6px"
                      }
                    },
                    ".icon-wrapper": {
                      "position": "absolute",
                      "top": "0",
                      "right": "10px",
                      "display": "inline-flex",
                      "align-items": "center",
                      "justify-content": "center",
                      "width": "32px",
                      "height": "32px",
                      "min-width": "32px",
                      "background-color": "@iconBg",
                      "transition": "all .3s ease",
                      "margin-left": "30px",
                      ".mbr-iconfont": {
                        "display": "inline-flex",
                        "transition": "all .3s ease",
                        "font-size": "14px",
                        "margin": "0",
                        "transform": "rotate(-45deg)",
                        "padding": "10px"
                      }
                    }
                  }
                }
              }
            },
            ".mbr-label": {
              "color": "#1f1f1f"
            },
            ".mbr-section-title": {
              "color": "#1f1f1f"
            },
            ".mbr-text": {
              "color": "#5a5a5a"
            },
            ".item-date": {
              "color": "#5a5a5a"
            },
            ".item-title": {
              "color": "#1f1f1f"
            },
            ".item-text": {
              "color": "#5a5a5a"
            },
            ".mbr-section-title, .title-wrapper, .main-btn": {
              "text-align": "center",
              "color": "#ffffff"
            },
            ".item-title, .item-btn": {
              "color": "#ffffff"
            }
          },
          "_cid": "vaHlWB7Yxa",
          "_anchor": "features03-5v",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "_name": "article02",
          "_sourceTheme": "speakerm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"article02 speakerm5\" group=\"Article\" mbr-class=\"{'mbr-fullscreen': fullScreen, 'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"0\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\">\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\">\n        <input type=\"checkbox\" title=\"Description\" name=\"showDesc\" checked>\n        <input type=\"color\" title=\"Description BG\" value=\"#A0FFC2\" name=\"desc\" cobdition=\"showDesc\" selected>\n        <input type=\"checkbox\" title=\"Card Title\" name=\"showCardTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Social\" name=\"showSocial\" checked>\n        <input type=\"range\" name=\"socialCount\" title=\"Count\" min=\"1\" max=\"3\" step=\"1\" value=\"2\" condition=\"showSocial\">\n        <input type=\"color\" title=\"Color\" name=\"icon\" value=\"#ffffff\" condition=\"showSocial\">\n        <input type=\"color\" title=\"Active BG\" name=\"activeBg\" value=\"#2125f1\" condition=\"showSocial\">\n        <input type=\"color\" title=\"Card BG\" value=\"#0e0f2d\" name=\"card\" selected>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@ADDONS_PATH@/speakerm5/components/_images/background1.jpg\" parallax>\n            <input type=\"color\" title=\"Color\" value=\"#000000\" selected>\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@ADDONS_PATH@/speakerm5/components/_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#E33030\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.2\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n            <div class=\"col-12 col-lg-5\" mbr-if=\"showTitle\">\n                <div class=\"title-wrapper\">\n                    <h2 class=\"mbr-section-title mbr-fonts-style\" mbr-theme-style=\"display-2\" data-app-selector=\".mbr-section-title, .mbr-section-btn\">\n                        <b>DISCOGRAFÍA</b></h2>\n                </div>\n            </div>\n            <div class=\"col-12 col-lg-5\" mbr-if=\"showButtons\">\n                <div class=\"mbr-section-btn\" data-toolbar=\"-mbrBtnMove\" mbr-buttons mbr-theme-style=\"display-4\">\n                    <a href class=\"btn item-btn btn-primary-outline\" data-app-placeholder=\"Type Text\">\n                        More Speakers\n                    </a>\n                </div>\n            </div>\n            <div class=\"col-12 col-lg-10\">\n                <div class=\"content-wrapper\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n                    <div class=\"image-wrapper\">\n                        <img src=\"@PROJECT_PATH@/assets/images/raga-logo1-608x600.jpg\" alt>\n                    </div>\n                    <div class=\"cont-wrapper\">\n                        <div class=\"desc-wrap\">\n                            <p class=\"mbr-desc mbr-fonts-style\" data-app-selector=\".mbr-desc, .desc-wrap\" mbr-theme-style=\"display-4\" mbr-if=\"showDesc\">2019</p>\n                        </div>\n                        <h4 class=\"mbr-card-title mbr-fonts-style\" data-app-selector=\".mbr-card-title, .social-wrap\" mbr-theme-style=\"display-5\" mbr-if=\"showCardTitle\"><b>Raga Ensamble de Percusiones de México</b></h4>\n                        <p class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-4\" mbr-if=\"showText\">Track List:\n<br>1. Magenta Edwin Tovar\n<br>2. Doll´s House History Marta Istvan\n<br>3. Danza Isorrítmica Mario Lavista\n<br>4. Convertation in the Forest Keiko Abe\n<br>5. 3 Dances Takayoshi Yoshioka\n<br>6. Obsession\n<br>7. Adoration\n<br>8. Expectation<br><br>Obras de Salvador, Ernesto Juárez y Edwin Tovar<br></p>\n                        <div class=\"social-wrap\">\n                            <div class=\"social-row\" mbr-if=\"showSocial\">\n                                <div class=\"soc-item\">\n                                    <a href=\"https://www.facebook.com/Mobirise/\" target=\"_blank\">\n                                        <span mbr-icon class=\"mbr-iconfont socicon-spotify socicon\"></span>\n                                    </a>\n                                </div>\n                                <div class=\"soc-item\" mbr-if=\"socialCount > 1\">\n                                    <a href=\"https://twitter.com/mobirise\" target=\"_blank\">\n                                        <span mbr-icon class=\"mbr-iconfont mbri-apple\"></span>\n                                    </a>\n                                </div>\n                                <div class=\"soc-item\" mbr-if=\"socialCount > 2\">\n                                    <a href=\"https://instagram.com/mobirise\" target=\"_blank\">\n                                        <span mbr-icon class=\"mbr-iconfont socicon socicon-instagram\"></span>\n                                    </a>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
